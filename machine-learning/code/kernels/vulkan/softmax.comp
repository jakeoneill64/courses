#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require

// snippet:begin softmax
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) writeonly buffer Y { float y[]; };
layout(push_constant) uniform Sizes { uint cols; };
shared float partial[32];

float groupReduce(float value, bool isMax) {
    value = isMax ? subgroupMax(value) : subgroupAdd(value);
    if (gl_SubgroupInvocationID == 0) partial[gl_SubgroupID] = value;
    barrier();
    float mine = gl_SubgroupInvocationID < gl_NumSubgroups ? partial[gl_SubgroupInvocationID]
                                                          : (isMax ? -1.0 / 0.0 : 0.0);
    value = isMax ? subgroupMax(mine) : subgroupAdd(mine);
    barrier();
    return value;
}

void main() {
    uint base = gl_WorkGroupID.x * cols, t = gl_LocalInvocationID.x;
    float peak = -1.0 / 0.0;
    for (uint i = t; i < cols; i += 256) peak = max(peak, x[base + i]);
    peak = groupReduce(peak, true);
    float total = 0.0;
    for (uint i = t; i < cols; i += 256) total += exp(x[base + i] - peak);
    total = groupReduce(total, false);
    for (uint i = t; i < cols; i += 256) y[base + i] = exp(x[base + i] - peak) / total;
}
// snippet:end softmax
