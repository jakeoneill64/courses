#version 460
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 256) in;
layout(constant_id = 0) const uint FMAS = 1;

layout(push_constant) uniform Push {
    float a;
    float b;
    uint count;
} push;

layout(std430, set = 0, binding = 0) restrict readonly buffer Src { vec4 src[]; };
layout(std430, set = 0, binding = 1) restrict writeonly buffer Dst { vec4 dst[]; };

// snippet:begin roofline
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.count / 4) return;
    vec4 v = src[i];
    uint k = 0;
    // Loop overhead would dominate a rolled loop of single FMAs, so the bulk is unrolled.
    for (; k + 16 <= FMAS; k += 16) {
        [[unroll]] for (uint j = 0; j < 16; ++j) {
            v = fma(v, vec4(push.a), vec4(push.b));
        }
    }
    for (; k < FMAS; ++k) {
        v = fma(v, vec4(push.a), vec4(push.b));
    }
    dst[i] = v;
}
// snippet:end roofline
