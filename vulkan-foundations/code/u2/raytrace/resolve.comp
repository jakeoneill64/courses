#version 460

layout(local_size_x = 8, local_size_y = 8) in;

#include "scene.glsl"

// snippet:begin resolve
// Narkowicz's fit to the ACES filmic tone curve.
vec3 toneMap(vec3 x) {
    return clamp(x * (2.51 * x + 0.03) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

vec3 encodeSrgb(vec3 c) {
    vec3 curve = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
    return mix(12.92 * c, curve, greaterThan(c, vec3(0.0031308)));
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= scene.width || p.y >= scene.height) return;
    vec4 sum = imageLoad(accumulation, ivec2(p));
    imageStore(picture, ivec2(p), vec4(encodeSrgb(toneMap(sum.rgb / sum.a)), 1.0));
}
// snippet:end resolve
