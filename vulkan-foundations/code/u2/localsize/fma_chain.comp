#version 460
#extension GL_EXT_control_flow_attributes : require

// snippet:begin chain
layout(local_size_x_id = 0) in;
const uint CHAIN = 512;

layout(push_constant) uniform Push {
    float a;
    float b;
    uint n;
} push;

layout(std430, set = 0, binding = 0) readonly buffer X { float x[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Z { float z[]; };

void main() {
    uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < push.n; i += stride) {
        float v = x[i];
        [[unroll]] for (uint k = 0; k < CHAIN; ++k) {
            v = fma(v, push.a, push.b);
        }
        z[i] = v;
    }
}
// snippet:end chain
