#version 460

layout(local_size_x_id = 0) in;

layout(push_constant) uniform Push {
    uint count;
} push;

// snippet:begin scatter
layout(std430, set = 0, binding = 0) restrict readonly buffer Values { uint values[]; };
layout(std430, set = 0, binding = 1) restrict readonly buffer Flags { uint flags[]; };
layout(std430, set = 0, binding = 2) restrict readonly buffer Positions { uint positions[]; };
layout(std430, set = 0, binding = 3) restrict writeonly buffer Kept { uint kept[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < push.count && flags[i] != 0) kept[positions[i]] = values[i];
}
// snippet:end scatter
