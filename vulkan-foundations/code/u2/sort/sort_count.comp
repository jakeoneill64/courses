#version 460

layout(local_size_x_id = 0) in;

#include "sort.glsl"

layout(std430, set = 0, binding = 0) restrict readonly buffer Keys { uint keys[]; };
layout(std430, set = 0, binding = 1) restrict writeonly buffer Counts { uint counts[]; };

shared uint histogram[BUCKETS];

// snippet:begin count
void main() {
    for (uint d = gl_LocalInvocationIndex; d < BUCKETS; d += gl_WorkGroupSize.x) {
        histogram[d] = 0;
    }
    barrier();
    uint first = gl_WorkGroupID.x * gl_WorkGroupSize.x * ITEMS + gl_LocalInvocationIndex;
    for (uint k = 0; k < ITEMS; ++k) {
        uint i = first + k * gl_WorkGroupSize.x;
        if (i < push.count) atomicAdd(histogram[digitOf(keys[i])], 1u);
    }
    barrier();
    for (uint d = gl_LocalInvocationIndex; d < BUCKETS; d += gl_WorkGroupSize.x) {
        counts[d * push.blocks + gl_WorkGroupID.x] = histogram[d];
    }
}
// snippet:end count
