#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, r32ui) uniform readonly uimage2D field;
layout(std430, set = 0, binding = 1) writeonly buffer Blurred { uint blurred[]; };

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(field);
    if (p.x >= extent.x || p.y >= extent.y) return;
    uint total = 0u;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            total += imageLoad(field, clamp(p + ivec2(dx, dy), ivec2(0), extent - 1)).x;
        }
    }
    blurred[p.y * extent.x + p.x] = total;
}
