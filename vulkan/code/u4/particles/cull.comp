#version 460

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer Instances {
    vec4 positionScale[];
};

layout(std430, set = 0, binding = 1) writeonly buffer Visible {
    uint visible[];
};

// snippet:begin command
layout(std430, set = 0, binding = 2) buffer DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
} command;
// snippet:end command

layout(push_constant) uniform Frustum {
    vec4 planes[6];
    uint count;
} frustum;

// snippet:begin cull
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= frustum.count) return;
    vec4 s = positionScale[i];
    float radius = s.w * 1.7320508;
    for (int p = 0; p < 6; ++p) {
        if (dot(frustum.planes[p].xyz, s.xyz) + frustum.planes[p].w < -radius) return;
    }
    uint slot = atomicAdd(command.instanceCount, 1u);
    visible[slot] = i;
}
// snippet:end cull
