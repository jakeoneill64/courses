#version 460

layout(local_size_x = 256) in;

layout(push_constant) uniform Push {
    uint count;
} push;

layout(std430, set = 0, binding = 0) readonly buffer Uploaded { uint uploaded[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Results { uint results[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < push.count) results[i] = uploaded[i] * 3u + 1u;
}
