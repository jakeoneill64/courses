#version 460

layout(local_size_x = 256) in;

layout(push_constant) uniform Push {
    uint count;
} push;

layout(std430, set = 0, binding = 0) buffer Values { uint values[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < push.count) values[i] = values[i] * 1664525u + 1013904223u;
}
