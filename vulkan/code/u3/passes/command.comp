#version 460

layout(local_size_x = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Stats {
    uint selected;
    uint blurredSum;
    uint indexXor;
} stats;
layout(std430, set = 0, binding = 1) writeonly buffer Command {
    uint groupsX;
    uint groupsY;
    uint groupsZ;
};

void main() {
    groupsX = (stats.selected + 63u) / 64u;
    groupsY = 1u;
    groupsZ = 1u;
}
