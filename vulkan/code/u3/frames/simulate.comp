#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform Push {
    uint steps;
    uint seedCount;
} push;

layout(std430, set = 0, binding = 0) readonly buffer Seeds { uint seeds[]; };
layout(std430, set = 0, binding = 1) readonly buffer Palette { uint colours[256]; };
layout(set = 0, binding = 2, rgba8ui) uniform writeonly uimage2D frame;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(frame);
    if (p.x >= extent.x || p.y >= extent.y) return;
    uint i = uint(p.y * extent.x + p.x);
    uint x = seeds[i % push.seedCount] ^ i;
    for (uint s = 0u; s < push.steps; ++s) x = x * 1664525u + 1013904223u;
    uint c = colours[x >> 24];
    imageStore(frame, p, uvec4(c & 255u, (c >> 8) & 255u, (c >> 16) & 255u, c >> 24));
}
