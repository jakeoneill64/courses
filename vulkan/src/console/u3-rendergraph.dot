digraph rendergraph {
  rankdir=LR;
  node [fontname="Helvetica"];
  r7v0 [shape=ellipse, label="results"];
  p0 [shape=box, label="clear-stats"];
  r4v1 [shape=ellipse, label="stats", style=dashed];
  p0 -> r4v1;
  p1 [shape=box, label="generate"];
  r0v1 [shape=ellipse, label="field", style=dashed];
  p1 -> r0v1;
  p2 [shape=box, label="blur"];
  r0v1 -> p2;
  r1v1 [shape=ellipse, label="blurred", style=dashed];
  p2 -> r1v1;
  p3 [shape=box, label="edges"];
  r0v1 -> p3;
  r2v1 [shape=ellipse, label="edges", style=dashed];
  p3 -> r2v1;
  p4 [shape=box, label="debug-copy", style=dotted, fontcolor=gray];
  r1v1 -> p4;
  r8v1 [shape=ellipse, label="scratch", style=dashed];
  p4 -> r8v1;
  p5 [shape=box, label="select"];
  r1v1 -> p5;
  r2v1 -> p5;
  r4v1 -> p5;
  r4v2 [shape=ellipse, label="stats", style=dashed];
  p5 -> r4v2;
  r5v1 [shape=ellipse, label="list", style=dashed];
  p5 -> r5v1;
  r3v1 [shape=ellipse, label="mask", style=dashed];
  p5 -> r3v1;
  p6 [shape=box, label="command"];
  r4v2 -> p6;
  r6v1 [shape=ellipse, label="command", style=dashed];
  p6 -> r6v1;
  p7 [shape=box, label="score"];
  r6v1 -> p7;
  r5v1 -> p7;
  r1v1 -> p7;
  r4v2 -> p7;
  r4v3 [shape=ellipse, label="stats", style=dashed];
  p7 -> r4v3;
  p8 [shape=box, label="readback"];
  r4v3 -> p8;
  r3v1 -> p8;
  r7v1 [shape=ellipse, label="results"];
  p8 -> r7v1;
  p9 [shape=box, label="host"];
  r7v1 -> p9;
}
